    <ugv:typedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No enemy activity is modeled.</ugv:typedValue>
    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefA_R1, paragraph 2</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
    <ugv:isAbout rdf:resource="#MissionAlpha"/>
    <ugv:concernsFactor rdf:resource="#EnemiesFactor"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Terrain_A_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#TerrainAssertion"/>
    <ugv:field rdf:datatype="http://www.w3.org/2001/XMLSchema#string">terrain</ugv:field>
    <ugv:typedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marked inspection surfaces are level.</ugv:typedValue>
    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefA_R1, paragraph 3</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
    <ugv:isAbout rdf:resource="#MissionAlpha"/>
    <ugv:concernsFactor rdf:resource="#TerrainFactor"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TroopsAndSupport_A_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#TroopsAndSupportAssertion"/>
    <ugv:field rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support</ugv:field>
    <ugv:typedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rover01 and its inspection camera are available.</ugv:typedValue>
    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefA_R1, paragraph 4</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
    <ugv:isAbout rdf:resource="#MissionAlpha"/>
    <ugv:concernsFactor rdf:resource="#TroopsAndSupportFactor"/>
  </owl:NamedIndividual>
