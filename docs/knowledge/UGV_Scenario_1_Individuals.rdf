    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefA_R1, paragraph 6</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
