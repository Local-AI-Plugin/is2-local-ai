  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#IntakePass_A_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#ValidationResult"/>
    <ugv:checkName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brief intake</ugv:checkName>
    <ugv:outcome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pass</ugv:outcome>
    <ugv:explanation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All six categories are explicit, and the mission completion deadline has one active value.</ugv:explanation>
    <ugv:resultOf rdf:resource="#Intake_A_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#BriefAB_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#MissionBrief"/>
    <ugv:briefId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRIEF-AlphaBravo</ugv:briefId>
    <ugv:revision rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</ugv:revision>
