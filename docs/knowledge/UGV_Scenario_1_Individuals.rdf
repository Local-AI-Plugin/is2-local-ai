<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xml:base="https://example.org/is2/ugv-mission-planning/scenario-1" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:ugv="https://example.org/is2/ugv-mission-planning#">
  <owl:Ontology rdf:about=""><owl:imports rdf:resource="https://example.org/is2/ugv-mission-planning"/><rdfs:label>Scenario 1 controlled environmental inspection individuals</rdfs:label><rdfs:comment>Synthetic competency-question test data. Reports contain expected findings. Candidate plans assume a 10:30 UTC start, no waiting, continued site access and camera availability. Alpha uses brief A revision 1; Alpha-Bravo uses brief AB revision 3.</rdfs:comment></owl:Ontology>
  <owl:NamedIndividual rdf:about="#Staging">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Location"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Alpha">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#InspectionArea"/>
    <ugv:areaId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alpha</ugv:areaId>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AssessAlpha">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#AssessmentObjective"/>
    <ugv:desiredCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental observation recorded for Alpha.</ugv:desiredCondition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Bravo">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#InspectionArea"/>
    <ugv:areaId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bravo</ugv:areaId>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AssessBravo">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#AssessmentObjective"/>
    <ugv:desiredCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental observation recorded for Bravo.</ugv:desiredCondition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#ObserveAreaTask">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Task"/>
    <ugv:taskName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observe an inspection area</ugv:taskName>
    <ugv:supportsObjective rdf:resource="#AssessAlpha"/>
    <ugv:supportsObjective rdf:resource="#AssessBravo"/>
    <ugv:hasRequirement rdf:resource="#ReqCameraObservation"/>
    <ugv:hasPrerequisite rdf:resource="#PreCameraAvailable"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MoveTask">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Task"/>
    <ugv:taskName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move between inspection locations</ugv:taskName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#CameraObservation">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Capability"/>
    <ugv:capabilityName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Camera observation</ugv:capabilityName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#ReqCameraObservation">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#CapabilityRequirement"/>
    <ugv:requiresCapability rdf:resource="#CameraObservation"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#InspectionPlatform">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Platform"/>
    <ugv:supportsCapability rdf:resource="#CameraObservation"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Rover01">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#UGV"/>
    <ugv:vehicleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rover01</ugv:vehicleId>
    <ugv:hasConfiguration rdf:resource="#InspectionPlatform"/>
    <ugv:hasSnapshot rdf:resource="#Snapshot1030"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#PreCameraAvailable">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Prerequisite"/>
    <ugv:requiresState rdf:resource="#CameraAvailableAtObservation"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#CameraAvailableAtObservation">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#StateCondition"/>
    <ugv:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#Camera01</ugv:subject>
    <ugv:property rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#availability</ugv:property>
    <ugv:requiredValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ugv:requiredValue>
    <ugv:applicableTime rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At observation start</ugv:applicableTime>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Snapshot1030">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#VehicleStateSnapshot"/>
    <ugv:recordedAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-26T10:30:00Z</ugv:recordedAt>
    <ugv:snapshotOf rdf:resource="#Rover01"/>
    <ugv:containsReading rdf:resource="#CameraReady1030"/>
    <ugv:containsReading rdf:resource="#EnergyAvailable1030"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#CameraReady1030">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#ObservedStateValue"/>
    <ugv:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#Camera01</ugv:subject>
    <ugv:property rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#availability</ugv:property>
    <ugv:observedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ugv:observedValue>
    <ugv:readingOf rdf:resource="#Snapshot1030"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#EnergyAvailable1030">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#ObservedStateValue"/>
    <ugv:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#Rover01</ugv:subject>
    <ugv:property rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning/scenario-1#availableEnergyWh</ugv:property>
    <ugv:observedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</ugv:observedValue>
    <ugv:readingOf rdf:resource="#Snapshot1030"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MissionObjectivesFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissionObjectives</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#EnemiesFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enemies</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TerrainFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Terrain</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TroopsAndSupportFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TroopsAndSupport</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#TimeAndDeadlinesFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TimeAndDeadlines</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#CiviliansAndInfrastructureFactor">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#METTCFactor"/>
    <ugv:factorName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CiviliansAndInfrastructure</ugv:factorName>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#ReqTerrainEntry">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#CompletenessRequirement"/>
    <ugv:requirementId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TERRAIN-ENTRY</ugv:requirementId>
    <ugv:expectedAssertionClass rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/is2/ugv-mission-planning#TerrainAssertion</ugv:expectedAssertionClass>
    <ugv:scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mission</ugv:scope>
    <ugv:requiredField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">terrain</ugv:requiredField>
    <ugv:applicabilityCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every controlled-site inspection brief.</ugv:applicabilityCondition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Reserve20Wh">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#PlanningConstraint"/>
    <ugv:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimum energy remaining after return</ugv:description>
    <ugv:scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Candidate completion</ugv:scope>
    <ugv:comparison rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&gt;=</ugv:comparison>
    <ugv:limitValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20</ugv:limitValue>
    <ugv:unitOrTimeBasis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wh remaining</ugv:unitOrTimeBasis>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MissionAlpha">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Mission"/>
    <ugv:missionId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissionAlpha</ugv:missionId>
    <ugv:assignsVehicle rdf:resource="#Rover01"/>
    <ugv:assignsTask rdf:resource="#MoveTask"/>
    <ugv:assignsTask rdf:resource="#ObserveAreaTask"/>
    <ugv:hasObjective rdf:resource="#AssessAlpha"/>
    <ugv:setsLimit rdf:resource="#AlphaDeadline"/>
    <ugv:setsLimit rdf:resource="#Reserve20Wh"/>
    <ugv:hasCandidate rdf:resource="#AlphaCOA"/>
    <ugv:documentedBy rdf:resource="#BriefA_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AlphaDeadline">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#PlanningConstraint"/>
    <ugv:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complete the required return by noon.</ugv:description>
    <ugv:scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissionAlpha</ugv:scope>
    <ugv:comparison rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;=</ugv:comparison>
    <ugv:limitValue rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-26T12:00:00Z</ugv:limitValue>
    <ugv:unitOrTimeBasis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UTC</ugv:unitOrTimeBasis>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AlphaCOA">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#CourseOfAction"/>
    <ugv:hasVersion rdf:resource="#Alpha_V1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MissionAlphaBravo">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#Mission"/>
    <ugv:missionId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissionAlphaBravo</ugv:missionId>
    <ugv:assignsVehicle rdf:resource="#Rover01"/>
    <ugv:assignsTask rdf:resource="#MoveTask"/>
    <ugv:assignsTask rdf:resource="#ObserveAreaTask"/>
    <ugv:hasObjective rdf:resource="#AssessAlpha"/>
    <ugv:hasObjective rdf:resource="#AssessBravo"/>
    <ugv:setsLimit rdf:resource="#AlphaBravoDeadline"/>
    <ugv:setsLimit rdf:resource="#Reserve20Wh"/>
    <ugv:hasCandidate rdf:resource="#AlphaBravoCOA"/>
    <ugv:documentedBy rdf:resource="#BriefAB_R1"/>
    <ugv:documentedBy rdf:resource="#BriefAB_R2"/>
    <ugv:documentedBy rdf:resource="#BriefAB_R3"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AlphaBravoDeadline">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#PlanningConstraint"/>
    <ugv:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complete the required return by noon.</ugv:description>
    <ugv:scope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissionAlphaBravo</ugv:scope>
    <ugv:comparison rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;=</ugv:comparison>
    <ugv:limitValue rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-26T12:00:00Z</ugv:limitValue>
    <ugv:unitOrTimeBasis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UTC</ugv:unitOrTimeBasis>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#AlphaBravoCOA">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#CourseOfAction"/>
    <ugv:hasVersion rdf:resource="#AlphaBravo_V1"/>
    <ugv:hasVersion rdf:resource="#AlphaBravo_V2"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#BriefA_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#MissionBrief"/>
    <ugv:briefId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BRIEF-Alpha</ugv:briefId>
    <ugv:revision rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</ugv:revision>
    <ugv:hasIntakeReport rdf:resource="#Intake_A_R1"/>
    <ugv:supplies rdf:resource="#MissionObjectives_A_R1"/>
    <ugv:supplies rdf:resource="#Enemies_A_R1"/>
    <ugv:supplies rdf:resource="#Terrain_A_R1"/>
    <ugv:supplies rdf:resource="#TroopsAndSupport_A_R1"/>
    <ugv:supplies rdf:resource="#Deadline1200_A_R1"/>
    <ugv:supplies rdf:resource="#CiviliansAndInfrastructure_A_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Intake_A_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#IntakeValidationReport"/>
    <ugv:checkedAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-26T10:01:00Z</ugv:checkedAt>
    <ugv:checkCoverage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six category entries, mission completion deadline, and active single-value conflicts.</ugv:checkCoverage>
    <ugv:checkedBriefRevision rdf:resource="#BriefA_R1"/>
    <ugv:containsResult rdf:resource="#IntakePass_A_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MissionObjectives_A_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#MissionObjectivesAssertion"/>
    <ugv:field rdf:datatype="http://www.w3.org/2001/XMLSchema#string">objectives</ugv:field>
    <ugv:typedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observe Alpha and return to staging.</ugv:typedValue>
    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefA_R1, paragraph 1</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
    <ugv:isAbout rdf:resource="#MissionAlpha"/>
    <ugv:concernsFactor rdf:resource="#MissionObjectivesFactor"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Enemies_A_R1">
