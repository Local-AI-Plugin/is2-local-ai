    <ugv:supplies rdf:resource="#Enemies_AB_R1"/>
    <ugv:supplies rdf:resource="#TroopsAndSupport_AB_R1"/>
    <ugv:supplies rdf:resource="#Deadline1200_AB_R1"/>
    <ugv:supplies rdf:resource="#CiviliansAndInfrastructure_AB_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Intake_AB_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#IntakeValidationReport"/>
    <ugv:checkedAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-26T10:01:00Z</ugv:checkedAt>
    <ugv:checkCoverage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six category entries, mission completion deadline, and active single-value conflicts.</ugv:checkCoverage>
    <ugv:checkedBriefRevision rdf:resource="#BriefAB_R1"/>
    <ugv:containsResult rdf:resource="#MissingTerrain_R1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#MissionObjectives_AB_R1">
    <rdf:type rdf:resource="https://example.org/is2/ugv-mission-planning#MissionObjectivesAssertion"/>
    <ugv:field rdf:datatype="http://www.w3.org/2001/XMLSchema#string">objectives</ugv:field>
    <ugv:typedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observe Alpha and Bravo and return to staging.</ugv:typedValue>
    <ugv:sourceLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BriefAB_R1, paragraph 1</ugv:sourceLocation>
    <ugv:assertionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</ugv:assertionStatus>
