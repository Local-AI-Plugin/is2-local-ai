    <ugv:evaluatedConstraint rdf:resource="#Reserve20Wh"/>
    <ugv:applicableLimit rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20</ugv:applicableLimit>
    <ugv:evaluatedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">48</ugv:evaluatedValue>
    <ugv:unitOrTimeBasis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wh remaining</ugv:unitOrTimeBasis>
  </owl:NamedIndividual>
</rdf:RDF>
